def execute_preset_action(
    sim: Any,
    player: int,
    player_left_motor: int,
    player_right_motor: int,
    state: dict[str, Any],
    command: str,
) -> None:
    targets = state["targets"]

    if command == "APPROACH_SIDE_LEFT":
        drive_to_point(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            targets["side_left"],
            PLAYER_SPEED,
        )

    elif command == "APPROACH_SIDE_RIGHT":
        drive_to_point(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            targets["side_right"],
            PLAYER_SPEED,
        )

    elif command == "GO_BEHIND_BALL":
        drive_to_point(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            targets["behind_ball"],
            PLAYER_SPEED,
        )

    elif command == "ALIGN_TO_GOAL":
        face_point(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            state["goal"]["position"],
            PLAYER_SPEED,
        )

    elif command == "DRIBBLE_FORWARD":
        drive_forward_to_point(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            targets["push_target"],
            PLAYER_SPEED,
        )

    elif command == "AVOID_LEFT":
        # Preset open-loop body-space Twist.
        set_diff_drive(
            sim,
            player_left_motor,
            player_right_motor,
            linear_velocity=0.05,
            angular_velocity=1.20,
        )

    elif command == "AVOID_RIGHT":
        # Preset open-loop body-space Twist.
        set_diff_drive(
            sim,
            player_left_motor,
            player_right_motor,
            linear_velocity=0.05,
            angular_velocity=-1.20,
        )

    else:
        stop_robot(sim, player_left_motor, player_right_motor)


def robot_interface(
    sim: Any,
    player: int,
    player_left_motor: int,
    player_right_motor: int,
    state: dict[str, Any],
    action: dict[str, Any],
) -> None:
    """
    Single state-action interface between CoppeliaSim and the AI layer.

    Supported action types:
    1. preset         -> high-level command selected by the LLM
    2. body_twist     -> linear and angular body-space velocity
    3. joint_velocity -> direct left and right wheel velocity
    """

    action_type = action.get("type", "preset")

    if action_type == "preset":
        execute_preset_action(
            sim,
            player,
            player_left_motor,
            player_right_motor,
            state,
            str(action.get("command", "STOP")),
        )

    elif action_type == "body_twist":
        linear_velocity = float(action.get("linear_velocity", 0.0))
        angular_velocity = float(action.get("angular_velocity", 0.0))

        set_diff_drive(
            sim,
            player_left_motor,
            player_right_motor,
            linear_velocity,
            angular_velocity,
        )

    elif action_type == "joint_velocity":
        left_wheel_velocity = float(
            action.get("left_wheel_velocity", 0.0)
        )
        right_wheel_velocity = float(
            action.get("right_wheel_velocity", 0.0)
        )

        set_joint_velocity(
            sim,
            player_left_motor,
            player_right_motor,
            left_wheel_velocity,
            right_wheel_velocity,
        )

    else:
        stop_robot(sim, player_left_motor, player_right_motor)


