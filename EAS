# ============================================================
# 7. GENERAL UTILITIES
# ============================================================


def dist2d(a: list[float], b: list[float]) -> float:
    return math.hypot(a[0] - b[0], a[1] - b[1])


def angle_wrap(angle: float) -> float:
    while angle > math.pi:
        angle -= 2.0 * math.pi
    while angle < -math.pi:
        angle += 2.0 * math.pi
    return angle


def clamp(value: float, minimum: float, maximum: float) -> float:
    return max(minimum, min(value, maximum))


def get_xyz(sim: Any, obj: int) -> list[float]:
    position = sim.getObjectPosition(obj, sim.handle_world)
    return [float(position[0]), float(position[1]), float(position[2])]


def get_yaw(sim: Any, obj: int) -> float:
    orientation = sim.getObjectOrientation(obj, sim.handle_world)
    return float(orientation[2])


def get_actual_velocity(sim: Any, obj: int) -> tuple[list[float], list[float]]:
    linear_velocity, angular_velocity = sim.getObjectVelocity(obj)

    linear = [
        float(linear_velocity[0]),
        float(linear_velocity[1]),
        float(linear_velocity[2]),
    ]
    angular = [
        float(angular_velocity[0]),
        float(angular_velocity[1]),
        float(angular_velocity[2]),
    ]

    return linear, angular


