def main() -> None:
    client = RemoteAPIClient()
    sim = client.require("sim")

    print("Connected to CoppeliaSim")

    player = sim.getObject(PLAYER_NAME)
    lawan_01 = sim.getObject(LAWAN_01_NAME)
    lawan_02 = sim.getObject(LAWAN_02_NAME)

    ball = sim.getObject(BALL_NAME)
    field = sim.getObject(FIELD_NAME)
    yellow_goal = sim.getObject(YELLOW_GOAL_NAME)
    white_goal = sim.getObject(WHITE_GOAL_NAME)

    player_left_motor, player_right_motor = get_robot_motors(
        sim,
        PLAYER_NAME,
    )
    lawan_01_left_motor, lawan_01_right_motor = get_robot_motors(
        sim,
        LAWAN_01_NAME,
    )
    lawan_02_left_motor, lawan_02_right_motor = get_robot_motors(
        sim,
        LAWAN_02_NAME,
    )

    player_sensor_definitions = discover_player_proximity_sensors(
        sim,
        player,
    )

    objects = {
        "Lapangan": field,
        "Robot_Pemain": player,
        "Robot_Lawan_01": lawan_01,
        "Robot_Lawan_02": lawan_02,
        "Bola_Merah": ball,
        "Gawang_Kuning": yellow_goal,
        "Gawang_Putih": white_goal,
    }

    initial_positions: dict[str, list[float]] = {}
    initial_orientations: dict[str, list[float]] = {}

    for name, obj in objects.items():
        initial_positions[name] = list(
            sim.getObjectPosition(obj, sim.handle_world)
        )
        initial_orientations[name] = list(
            sim.getObjectOrientation(obj, sim.handle_world)
        )

    print_initial_positions(sim, objects)

    ball_start = initial_positions["Bola_Merah"]
    field_position = initial_positions["Lapangan"]
    yellow_goal_origin_position = initial_positions["Gawang_Kuning"]
    white_goal_position = initial_positions["Gawang_Putih"]

    yellow_goal_center_position = get_goal_center_from_children(
        sim,
        yellow_goal,
        yellow_goal_origin_position,
    )
    yellow_goal_target_position = get_adjusted_goal_target(
        yellow_goal_center_position
    )

    field_x_min = min(
        yellow_goal_target_position[0],
        white_goal_position[0],
    ) - 1.0
    field_x_max = max(
        yellow_goal_target_position[0],
        white_goal_position[0],
    ) + 1.0
    field_y_min = field_position[1] - 3.2
    field_y_max = field_position[1] + 3.2

    right_ball_out_limit = field_x_max - RIGHT_OUT_TIGHTEN

    keeper_direction = 1
    keeper_state = {"mode": "face_goal"}

    lawan_01_state = {
        "direction": 1,
        "target": [field_position[0], field_position[1]],
    }

    update_lawan_01_patrol_target(
        field_position,
        yellow_goal_target_position,
        field_y_min,
        field_y_max,
        lawan_01_state,
    )

    if sim.getSimulationState() == sim.simulation_stopped:
        sim.startSimulation()
        time.sleep(1.0)

    llm_worker = LLMDecisionWorker()
    last_llm_request_time = -float("inf")

    current_action: dict[str, Any] = {
        "type": "preset",
        "command": "STOP",
        "reason": "Waiting for the first local LLM inference.",
        "source": "INITIAL",
        "latency_s": 0.0,
    }

    last_printed_command = None

    try:
        while True:
            yellow_goal_center_position = get_goal_center_from_children(
                sim,
                yellow_goal,
                yellow_goal_origin_position,
            )
            yellow_goal_target_position = get_adjusted_goal_target(
                yellow_goal_center_position
            )

            keeper_base_x = yellow_goal_center_position[0]
            keeper_y_min = (
                yellow_goal_center_position[1] - KEEPER_PATROL_RANGE_Y
            )
            keeper_y_max = (
                yellow_goal_center_position[1] + KEEPER_PATROL_RANGE_Y
            )

            ball_position = get_xyz(sim, ball)
            lawan_01_position = get_xyz(sim, lawan_01)

            goal_check_x = abs(
                ball_position[0] - yellow_goal_target_position[0]
            )
            goal_check_y = abs(
                ball_position[1] - yellow_goal_target_position[1]
            )

            if goal_check_x < GOAL_CHECK_X and goal_check_y < GOAL_CHECK_Y:
                print("\n[MISI SELESAI] Bola merah masuk gawang kuning.\n")

                stop_robot(
                    sim,
                    player_left_motor,
                    player_right_motor,
                )
                stop_robot(
                    sim,
                    lawan_01_left_motor,
                    lawan_01_right_motor,
                )
                stop_robot(
                    sim,
                    lawan_02_left_motor,
                    lawan_02_right_motor,
                )

                time.sleep(5.0)

                reset_game(
                    sim,
                    objects,
                    initial_positions,
                    initial_orientations,
                )

                keeper_direction = 1
                keeper_state["mode"] = "face_goal"
                lawan_01_state["direction"] = 1

                update_lawan_01_patrol_target(
                    field_position,
                    yellow_goal_target_position,
                    field_y_min,
                    field_y_max,
                    lawan_01_state,
                )

                current_action = {
                    "type": "preset",
                    "command": "STOP",
                    "reason": "Game reset; waiting for new inference.",
                    "source": "RESET",
                    "latency_s": 0.0,
                }

                last_llm_request_time = -float("inf")
                continue

            ball_is_out = (
                ball_position[0] < field_x_min - BALL_OUT_MARGIN
                or ball_position[0]
                > right_ball_out_limit + BALL_OUT_MARGIN
                or ball_position[1] < field_y_min - BALL_OUT_MARGIN
                or ball_position[1] > field_y_max + BALL_OUT_MARGIN
            )

            if ball_is_out:
                print("[RESET] Bola keluar lapangan; bola dikembalikan.")
                reset_ball(
                    sim,
                    ball,
                    ball_start,
                    initial_orientations["Bola_Merah"],
                )

            state = build_player_state(
                sim,
                player,
                lawan_01,
                lawan_02,
                ball,
                yellow_goal_target_position,
                player_sensor_definitions,
            )

            # Do not leave the player stopped while the local model is loading.
            # A deterministic command starts the mission immediately; the first
            # LLM result replaces it as soon as inference is available.
            if current_action.get("source") in {"INITIAL", "RESET"}:
                warm_start_command = rule_based_player_command(state)
                current_action = {
                    "type": "preset",
                    "command": warm_start_command,
                    "reason": (
                        "Immediate warm-start command while the local LLM "
                        "prepares its first decision."
                    ),
                    "source": "WARM_START",
                    "latency_s": 0.0,
                }
                print_llm_decision(state, current_action)
                last_printed_command = warm_start_command

            current_time = time.monotonic()

            if (
                current_time - last_llm_request_time
                >= LLM_REQUEST_INTERVAL
            ):
                submitted = llm_worker.submit(state)

                if submitted:
                    last_llm_request_time = current_time

            new_llm_action = llm_worker.get_latest_result()

            if new_llm_action is not None:
                current_action = new_llm_action
                print_llm_decision(state, current_action)
                last_printed_command = current_action.get("command")

            safe_action = apply_safety_override(state, current_action)

            if (
                safe_action.get("command") != last_printed_command
                and safe_action.get("source") == "SAFETY"
            ):
                print(
                    f"[SAFETY OVERRIDE] "
                    f"{current_action.get('command')} -> "
                    f"{safe_action.get('command')} | "
                    f"{safe_action.get('reason')}"
                )
                last_printed_command = safe_action.get("command")

            robot_interface(
                sim,
                player,
                player_left_motor,
                player_right_motor,
                state,
                safe_action,
            )

            keeper_direction = keeper_control(
                sim,
                lawan_02,
                lawan_02_left_motor,
                lawan_02_right_motor,
                yellow_goal_center_position,
                keeper_base_x,
                keeper_y_min,
                keeper_y_max,
                keeper_state,
                keeper_direction,
            )

            if (
                dist2d(
                    lawan_01_position,
                    lawan_01_state["target"],
                )
                < LAWAN_01_REACH_TOL
            ):
                update_lawan_01_patrol_target(
                    field_position,
                    yellow_goal_target_position,
                    field_y_min,
                    field_y_max,
                    lawan_01_state,
                )

            drive_to_point(
                sim,
                lawan_01,
                lawan_01_left_motor,
                lawan_01_right_motor,
                lawan_01_state["target"],
                PARTICIPATOR_SPEED,
            )

            time.sleep(CONTROL_DT)

    except KeyboardInterrupt:
        print("\nProgram dihentikan oleh user.")

    finally:
        llm_worker.close()

        stop_robot(sim, player_left_motor, player_right_motor)
        stop_robot(sim, lawan_01_left_motor, lawan_01_right_motor)
        stop_robot(sim, lawan_02_left_motor, lawan_02_right_motor)

        print("Semua robot dihentikan.")


if __name__ == "__main__":
    main()
