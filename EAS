def make_llm_state_summary(state: dict[str, Any]) -> dict[str, Any]:
    """Only send compact numeric state to the LLM."""

    return {
        "mission": state["mission"],
        "robot_position": state["robot"]["position"][:2],
        "robot_yaw_rad": state["robot"]["yaw_rad"],
        "robot_linear_speed_mps": state["robot"]["linear_speed_mps"],
        "robot_angular_speed_radps": state["robot"][
            "angular_speed_radps"
        ],
        "goal_position": state["goal"]["position"][:2],
        "distance_robot_to_goal_m": state["goal"][
            "distance_from_robot_m"
        ],
        "distance_ball_to_goal_m": state["goal"][
            "distance_from_ball_m"
        ],
        "face_goal_error_rad": state["goal"]["face_goal_error_rad"],
        "ball_position": state["ball"]["position"][:2],
        "distance_robot_to_ball_m": state["ball"][
            "distance_from_robot_m"
        ],
        "face_ball_error_rad": state["ball"]["face_ball_error_rad"],
        "alignment": state["alignment"],
        "proximity_sensor_m": state["sensor"],
        "distance_to_lawan_01_m": state["opponents"][
            "distance_to_lawan_01_m"
        ],
        "distance_to_lawan_02_m": state["opponents"][
            "distance_to_lawan_02_m"
        ],
    }


def llm_inference(state: dict[str, Any]) -> dict[str, Any]:
    start_time = time.monotonic()

    # Keep the instruction short. The model only needs to classify the
    # current state into one allowed high-level action.
    system_prompt = (
        "Control a Pioneer P3DX soccer robot. Return one allowed action. "
        "Priority: STOP if goal reached; avoid a front obstacle under "
        "0.30 m toward the clearer side; side-approach when close to the "
        "ball but not behind it; GO_BEHIND_BALL until alignment is valid; "
        "ALIGN_TO_GOAL until heading error is within 0.10 rad; otherwise "
        "DRIBBLE_FORWARD."
    )

    # Compact JSON reduces prompt-processing time.
    user_prompt = json.dumps(
        make_llm_state_summary(state),
        separators=(",", ":"),
        ensure_ascii=False,
    )

    try:
        response = chat(
            model=MODEL_NAME,
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt},
            ],
            format=ACTION_SCHEMA,
            keep_alive=LLM_KEEP_ALIVE,
            options={
                "temperature": 0,
                "num_ctx": LLM_NUM_CTX,
                "num_predict": LLM_NUM_PREDICT,
            },
        )

        result = json.loads(response.message.content)
        command = str(result.get("action", "STOP"))

        if command not in ALLOWED_PRESET_COMMANDS:
            raise ValueError(f"Invalid LLM command: {command}")

        return {
            "type": "preset",
            "command": command,
            "reason": f"LLM selected {command} from the latest robot state.",
            "source": "LLM",
            "latency_s": time.monotonic() - start_time,
        }

    except (
        ResponseError,
        json.JSONDecodeError,
        KeyError,
        TypeError,
        ValueError,
        ConnectionError,
    ) as error:
        fallback_command = rule_based_player_command(state)

        return {
            "type": "preset",
            "command": fallback_command,
            "reason": f"LLM error, deterministic fallback used: {error}",
            "source": "FALLBACK",
            "latency_s": time.monotonic() - start_time,
        }

    except Exception as error:
        fallback_command = rule_based_player_command(state)

        return {
            "type": "preset",
            "command": fallback_command,
            "reason": f"Unexpected LLM error, fallback used: {error}",
            "source": "FALLBACK",
            "latency_s": time.monotonic() - start_time,
        }


# ============================================================
# 16. NON-BLOCKING LLM WORKER
# ============================================================


class LLMDecisionWorker:
    """Run model loading and LLM inference outside the 20 Hz loop."""

    def __init__(self) -> None:
        self.request_queue: queue.Queue[dict[str, Any]] = queue.Queue(
            maxsize=1
        )
        self.result_queue: queue.Queue[dict[str, Any]] = queue.Queue(
            maxsize=1
        )
        self.stop_event = threading.Event()
        self.ready_event = threading.Event()
        self.thread = threading.Thread(
            target=self._worker_loop,
            daemon=True,
        )
        self.thread.start()

    def submit(self, state: dict[str, Any]) -> bool:
        """Keep only the newest state so the LLM never handles stale data."""
        snapshot = copy.deepcopy(state)

        try:
            while True:
                self.request_queue.get_nowait()
        except queue.Empty:
            pass

        try:
            self.request_queue.put_nowait(snapshot)
            return True
        except queue.Full:
            return False

    def get_latest_result(self) -> dict[str, Any] | None:
        latest_result = None

        while True:
            try:
                latest_result = self.result_queue.get_nowait()
            except queue.Empty:
                break

        return latest_result

    def close(self) -> None:
        self.stop_event.set()

    def _preload_model(self) -> None:
        start_time = time.monotonic()
        try:
            generate(
                model=MODEL_NAME,
                prompt="",
                keep_alive=LLM_KEEP_ALIVE,
                options={
                    "num_ctx": LLM_NUM_CTX,
                    "num_predict": 1,
                },
            )
            print(
                f"[LLM] Model {MODEL_NAME} ready in "
                f"{time.monotonic() - start_time:.2f} s."
            )
        except Exception as error:
            print(f"[LLM] Model preload failed: {error}")
        finally:
            self.ready_event.set()

    def _worker_loop(self) -> None:
        # Model loading occurs in this background thread, so the simulation
        # and rule-based warm-start action do not have to wait.
        self._preload_model()

        while not self.stop_event.is_set():
            try:
                state = self.request_queue.get(timeout=0.10)
            except queue.Empty:
                continue

            result = llm_inference(state)

            try:
                while True:
                    self.result_queue.get_nowait()
            except queue.Empty:
                pass

            try:
                self.result_queue.put_nowait(result)
            except queue.Full:
                pass


