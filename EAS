def discover_player_proximity_sensors(
    sim: Any,
    player: int,
) -> list[dict[str, Any]]:
    try:
        sensor_handles = sim.getObjectsInTree(
            player,
            sim.object_proximitysensor_type,
            1,
        )
    except Exception as error:
        print(f"[SENSOR] Gagal mencari proximity sensor: {error}")
        sensor_handles = []

    sensors: list[dict[str, Any]] = []

    for sensor_handle in sensor_handles:
        alias = get_object_alias_safe(sim, sensor_handle)

        try:
            # Matrix of the sensor frame relative to the robot frame.
            # CoppeliaSim proximity sensors detect along their local +Z axis.
            matrix = sim.getObjectMatrix(sensor_handle, player)

            sensor_z_axis_x = float(matrix[2])
            sensor_z_axis_y = float(matrix[6])
            heading_rad = math.atan2(sensor_z_axis_y, sensor_z_axis_x)
        except Exception:
            heading_rad = 0.0

        heading_deg = math.degrees(angle_wrap(heading_rad))

        if -35.0 <= heading_deg <= 35.0:
            sector = "front"
        elif 35.0 < heading_deg <= 80.0:
            sector = "front_left"
        elif 80.0 < heading_deg <= 125.0:
            sector = "left"
        elif -80.0 <= heading_deg < -35.0:
            sector = "front_right"
        elif -125.0 <= heading_deg < -80.0:
            sector = "right"
        else:
            sector = "other"

        sensors.append(
            {
                "handle": sensor_handle,
                "alias": alias,
                "heading_deg": heading_deg,
                "sector": sector,
            }
        )

    print("\n=== PLAYER PROXIMITY SENSOR DISCOVERY ===")

    if not sensors:
        print("Tidak ada proximity sensor ditemukan di bawah Robot_Pemain.")
        print(
            "Program tetap dapat berjalan karena "
            "REQUIRE_PROXIMITY_SENSOR=False."
        )
    else:
        for sensor in sensors:
            print(
                f"{sensor['alias']:35s} "
                f"heading={sensor['heading_deg']:7.2f} deg "
                f"sector={sensor['sector']}"
            )

    print("=========================================\n")

    if REQUIRE_PROXIMITY_SENSOR and not sensors:
        raise RuntimeError(
            "Proximity sensor wajib, tetapi tidak ditemukan. "
            "Tambahkan sensor ke Robot_Pemain atau periksa hierarchy."
        )

    return sensors


def read_single_proximity_distance(sim: Any, sensor_handle: int) -> float:
    try:
        reading = sim.readProximitySensor(sensor_handle)
    except Exception:
        return SENSOR_MAX_RANGE

    if not reading:
        return SENSOR_MAX_RANGE

    detected = bool(reading[0])

    if not detected:
        return SENSOR_MAX_RANGE

    # Depending on CoppeliaSim/API version, the second value can be a
    # scalar distance or a detected point vector. This parser supports both.
    for value in reading[1:3]:
        if isinstance(value, (int, float)):
            distance = float(value)
            if distance >= 0.0:
                return min(distance, SENSOR_MAX_RANGE)

        if isinstance(value, (list, tuple)) and len(value) >= 3:
            distance = math.sqrt(
                float(value[0]) ** 2
                + float(value[1]) ** 2
                + float(value[2]) ** 2
            )
            return min(distance, SENSOR_MAX_RANGE)

    return SENSOR_MAX_RANGE


def read_proximity_state(
    sim: Any,
    sensor_definitions: list[dict[str, Any]],
) -> dict[str, Any]:
    distances = {
        "front": SENSOR_MAX_RANGE,
        "front_left": SENSOR_MAX_RANGE,
        "front_right": SENSOR_MAX_RANGE,
        "left": SENSOR_MAX_RANGE,
        "right": SENSOR_MAX_RANGE,
    }

    for sensor in sensor_definitions:
        sector = sensor["sector"]

        if sector not in distances:
            continue

        distance = read_single_proximity_distance(
            sim,
            sensor["handle"],
        )

        distances[sector] = min(distances[sector], distance)

    return {
        "available": len(sensor_definitions) > 0,
        **distances,
    }


