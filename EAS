# 8. DIFFERENTIAL-DRIVE ACTION FUNCTIONS
# ============================================================


def stop_robot(sim: Any, left_motor: int, right_motor: int) -> None:
    sim.setJointTargetVelocity(left_motor, 0.0)
    sim.setJointTargetVelocity(right_motor, 0.0)


def set_joint_velocity(
    sim: Any,
    left_motor: int,
    right_motor: int,
    left_wheel_velocity: float,
    right_wheel_velocity: float,
) -> None:
    """Joint-space action: direct left and right wheel angular velocity."""

    sim.setJointTargetVelocity(left_motor, float(left_wheel_velocity))
    sim.setJointTargetVelocity(right_motor, float(right_wheel_velocity))


def body_to_joint_velocity(
    linear_velocity: float,
    angular_velocity: float,
) -> tuple[float, float]:
    """Convert body-space Twist (v, w) to wheel joint velocity."""

    left_wheel_velocity = (
        linear_velocity - angular_velocity * BODY_RADIUS
    ) / WHEEL_RADIUS

    right_wheel_velocity = (
        linear_velocity + angular_velocity * BODY_RADIUS
    ) / WHEEL_RADIUS

    return left_wheel_velocity, right_wheel_velocity


def set_diff_drive(
    sim: Any,
    left_motor: int,
    right_motor: int,
    linear_velocity: float,
    angular_velocity: float,
) -> None:
    """Body-space action followed by body-to-joint conversion."""

    left_wheel_velocity, right_wheel_velocity = body_to_joint_velocity(
        linear_velocity,
        angular_velocity,
    )

    set_joint_velocity(
        sim,
        left_motor,
        right_motor,
        left_wheel_velocity,
        right_wheel_velocity,
    )


# ============================================================
# 9. LOW-LEVEL CLOSED-LOOP MOTION CONTROLLERS
# ============================================================


def drive_to_point(
    sim: Any,
    robot: int,
    left_motor: int,
    right_motor: int,
    target_xy: list[float],
    speed_scale: float,
) -> None:
    position = get_xyz(sim, robot)
    yaw = get_yaw(sim, robot)

    dx = target_xy[0] - position[0]
    dy = target_xy[1] - position[1]

    target_angle = math.atan2(dy, dx)
    heading_error = angle_wrap(target_angle - yaw)
    distance = math.hypot(dx, dy)

    linear_velocity = BASE_V * speed_scale
    angular_velocity = BASE_W * speed_scale * heading_error

    angular_velocity = clamp(angular_velocity, -2.5, 2.5)

    if abs(heading_error) > 0.85:
        linear_velocity = 0.20 * BASE_V * speed_scale

    if distance < 0.10:
        linear_velocity = 0.0
        angular_velocity = 0.0

    set_diff_drive(
        sim,
        left_motor,
        right_motor,
        linear_velocity,
        angular_velocity,
    )


def face_point(
    sim: Any,
    robot: int,
    left_motor: int,
    right_motor: int,
    target_xy: list[float],
    speed_scale: float,
) -> float:
    position = get_xyz(sim, robot)
    yaw = get_yaw(sim, robot)

    dx = target_xy[0] - position[0]
    dy = target_xy[1] - position[1]

    target_angle = math.atan2(dy, dx)
    heading_error = angle_wrap(target_angle - yaw)

    linear_velocity = 0.0
    angular_velocity = BASE_W * speed_scale * heading_error
    angular_velocity = clamp(angular_velocity, -2.5, 2.5)

    if abs(heading_error) < 0.04:
        angular_velocity = 0.0

    set_diff_drive(
        sim,
        left_motor,
        right_motor,
        linear_velocity,
        angular_velocity,
    )

    return heading_error


def drive_forward_to_point(
    sim: Any,
    robot: int,
    left_motor: int,
    right_motor: int,
