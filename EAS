# 17. SAFETY VALIDATION
# ============================================================


def apply_safety_override(
    state: dict[str, Any],
    action: dict[str, Any],
) -> dict[str, Any]:
    safe_action = copy.deepcopy(action)

    if safe_action.get("type") != "preset":
        return safe_action

    command = safe_action.get("command", "STOP")

    if command not in ALLOWED_PRESET_COMMANDS:
        return {
            "type": "preset",
            "command": "STOP",
            "reason": "Invalid command rejected by safety layer.",
            "source": "SAFETY",
            "latency_s": safe_action.get("latency_s", 0.0),
        }

    if state["mission"]["goal_reached"]:
        return {
            "type": "preset",
            "command": "STOP",
            "reason": "Mission completed: ball reached the yellow goal.",
            "source": "SAFETY",
            "latency_s": safe_action.get("latency_s", 0.0),
        }

    sensor = state["sensor"]

    if sensor["available"] and sensor["front"] <= SENSOR_EMERGENCY_STOP:
        return {
            "type": "preset",
            "command": "STOP",
            "reason": "Emergency stop: obstacle is too close in front.",
            "source": "SAFETY",
            "latency_s": safe_action.get("latency_s", 0.0),
        }

    forward_related_commands = {
        "GO_BEHIND_BALL",
        "DRIBBLE_FORWARD",
        "APPROACH_SIDE_LEFT",
        "APPROACH_SIDE_RIGHT",
    }

    if (
        sensor["available"]
        and sensor["front"] < SENSOR_AVOID_DISTANCE
        and command in forward_related_commands
    ):
        left_clearance = min(sensor["front_left"], sensor["left"])
        right_clearance = min(sensor["front_right"], sensor["right"])

        avoid_command = (
            "AVOID_LEFT"
            if left_clearance >= right_clearance
            else "AVOID_RIGHT"
        )

        return {
            "type": "preset",
            "command": avoid_command,
            "reason": "Forward action overridden because front path is blocked.",
            "source": "SAFETY",
            "latency_s": safe_action.get("latency_s", 0.0),
        }

    return safe_action


