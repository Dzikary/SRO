# 14. DETERMINISTIC FALLBACK DECISION
# ============================================================


def rule_based_player_command(state: dict[str, Any]) -> str:
    """Used only when LLM inference fails or is unavailable."""

    if state["mission"]["goal_reached"]:
        return "STOP"

    sensor = state["sensor"]

    if sensor["available"] and sensor["front"] < SENSOR_AVOID_DISTANCE:
        left_clearance = min(sensor["front_left"], sensor["left"])
        right_clearance = min(sensor["front_right"], sensor["right"])

        if left_clearance >= right_clearance:
            return "AVOID_LEFT"
        return "AVOID_RIGHT"

    distance_to_ball = state["ball"]["distance_from_robot_m"]
    alignment = state["alignment"]

    if (
        distance_to_ball < SAFE_BALL_CLEARANCE
        and not alignment["is_behind_ball"]
    ):
        if alignment["lateral_error_m"] >= 0.0:
            return "APPROACH_SIDE_LEFT"
        return "APPROACH_SIDE_RIGHT"

    if (
        not alignment["is_on_goal_line"]
        or not alignment["is_behind_ball"]
        or not alignment["is_not_too_far"]
    ):
        return "GO_BEHIND_BALL"

    if abs(state["goal"]["face_goal_error_rad"]) > FACE_GOAL_TOLERANCE:
        return "ALIGN_TO_GOAL"

    return "DRIBBLE_FORWARD"


