def get_robot_motors(sim: Any, robot_path: str) -> tuple[int, int]:
    left_candidates = [
        robot_path + "/leftMotor",
        robot_path + "/left_motor",
        robot_path + "/PioneerP3DX_leftMotor",
        robot_path + "/leftWheel",
    ]

    right_candidates = [
        robot_path + "/rightMotor",
        robot_path + "/right_motor",
        robot_path + "/PioneerP3DX_rightMotor",
        robot_path + "/rightWheel",
    ]

    left_motor = None
    right_motor = None

    for name in left_candidates:
        try:
            left_motor = sim.getObject(name)
            break
        except Exception:
            pass

    for name in right_candidates:
        try:
            right_motor = sim.getObject(name)
            break
        except Exception:
            pass

    if left_motor is None or right_motor is None:
        raise RuntimeError(
            f"Motor tidak ditemukan untuk {robot_path}. "
            "Periksa nama motor pada Scene Hierarchy."
        )

    return left_motor, right_motor


def get_object_alias_safe(sim: Any, object_handle: int) -> str:
    try:
        return str(sim.getObjectAlias(object_handle, 1))
    except Exception:
        return str(object_handle)


