def keeper_control(
    sim: Any,
    lawan_02: int,
    lawan_02_left_motor: int,
    lawan_02_right_motor: int,
    yellow_goal_center_position: list[float],
    keeper_base_x: float,
    keeper_y_min: float,
    keeper_y_max: float,
    keeper_state: dict[str, Any],
    keeper_direction: int,
) -> int:
    lawan_02_position = get_xyz(sim, lawan_02)

    keeper_center_target = [
        keeper_base_x,
        yellow_goal_center_position[1],
    ]

    if keeper_state["mode"] == "face_goal":
        angle_error = face_point(
            sim,
            lawan_02,
            lawan_02_left_motor,
            lawan_02_right_motor,
            yellow_goal_center_position,
            KEEPER_SPEED,
        )

        if abs(angle_error) < KEEPER_FACE_ERROR:
            stop_robot(
                sim,
                lawan_02_left_motor,
                lawan_02_right_motor,
            )
            keeper_state["mode"] = "go_to_keeper_center"

        return keeper_direction

    if keeper_state["mode"] == "go_to_keeper_center":
        drive_to_point(
            sim,
            lawan_02,
            lawan_02_left_motor,
            lawan_02_right_motor,
            keeper_center_target,
            KEEPER_SPEED,
        )

        if dist2d(lawan_02_position, keeper_center_target) < KEEPER_START_DISTANCE:
            stop_robot(
                sim,
                lawan_02_left_motor,
                lawan_02_right_motor,
            )
            keeper_state["mode"] = "patrol"

        return keeper_direction

    if keeper_direction == 1:
        keeper_target = [keeper_base_x, keeper_y_max]

        if lawan_02_position[1] > keeper_y_max - KEEPER_PATROL_TOL:
            keeper_direction = -1
    else:
        keeper_target = [keeper_base_x, keeper_y_min]

        if lawan_02_position[1] < keeper_y_min + KEEPER_PATROL_TOL:
            keeper_direction = 1

    drive_to_point(
        sim,
        lawan_02,
        lawan_02_left_motor,
        lawan_02_right_motor,
        keeper_target,
        KEEPER_SPEED,
    )

    return keeper_direction


# ============================================================
# 20. RULE-BASED ROBOT_LAWAN_01 RANDOM PATROL
# ============================================================


def update_lawan_01_patrol_target(
    field_position: list[float],
    yellow_goal_target_position: list[float],
    field_y_min: float,
    field_y_max: float,
    lawan_01_state: dict[str, Any],
) -> None:
    random_y = random.uniform(
        field_y_min + LAWAN_01_Y_MARGIN,
        field_y_max - LAWAN_01_Y_MARGIN,
    )

    if yellow_goal_target_position[0] > field_position[0]:
        x_left = field_position[0] + 0.30
        x_right = yellow_goal_target_position[0] - 1.20
    else:
        x_left = yellow_goal_target_position[0] + 1.20
        x_right = field_position[0] - 0.30

    if lawan_01_state["direction"] == 1:
        lawan_01_state["target"] = [x_right, random_y]
        lawan_01_state["direction"] = -1
    else:
        lawan_01_state["target"] = [x_left, random_y]
        lawan_01_state["direction"] = 1


