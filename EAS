# 13. PLAYER GEOMETRY AND STATE CONSTRUCTION
# ============================================================


def get_goal_unit_vector(
    ball_position: list[float],
    goal_target_position: list[float],
) -> tuple[float, float]:
    dx = goal_target_position[0] - ball_position[0]
    dy = goal_target_position[1] - ball_position[1]

    length = math.hypot(dx, dy) + 1e-6
    return dx / length, dy / length


def get_line_alignment(
    player_position: list[float],
    ball_position: list[float],
    goal_target_position: list[float],
) -> tuple[float, float]:
    unit_x, unit_y = get_goal_unit_vector(
        ball_position,
        goal_target_position,
    )

    relative_x = player_position[0] - ball_position[0]
    relative_y = player_position[1] - ball_position[1]

    along_error = relative_x * unit_x + relative_y * unit_y
    lateral_error = relative_x * (-unit_y) + relative_y * unit_x

    return along_error, lateral_error


def calculate_player_targets(
    player_position: list[float],
    ball_position: list[float],
    goal_target_position: list[float],
) -> dict[str, Any]:
    del player_position  # target geometry only depends on ball and goal

    unit_x, unit_y = get_goal_unit_vector(
        ball_position,
        goal_target_position,
    )

    behind_ball_point = [
        ball_position[0] - unit_x * BEHIND_BALL_DISTANCE,
        ball_position[1] - unit_y * BEHIND_BALL_DISTANCE,
    ]

    side_left_point = [
        ball_position[0]
        - unit_x * BEHIND_BALL_DISTANCE
        + (-unit_y) * SIDE_APPROACH_OFFSET,
        ball_position[1]
        - unit_y * BEHIND_BALL_DISTANCE
        + unit_x * SIDE_APPROACH_OFFSET,
    ]

    side_right_point = [
        ball_position[0]
        - unit_x * BEHIND_BALL_DISTANCE
        - (-unit_y) * SIDE_APPROACH_OFFSET,
        ball_position[1]
        - unit_y * BEHIND_BALL_DISTANCE
        - unit_x * SIDE_APPROACH_OFFSET,
    ]

    push_target = [
        ball_position[0] + unit_x * DRIBBLE_FORWARD_DISTANCE,
        ball_position[1] + unit_y * DRIBBLE_FORWARD_DISTANCE,
    ]

    return {
        "behind_ball": behind_ball_point,
        "side_left": side_left_point,
        "side_right": side_right_point,
        "push_target": push_target,
        "goal_unit_vector": [unit_x, unit_y],
    }


def build_player_state(
    sim: Any,
    player: int,
    lawan_01: int,
    lawan_02: int,
    ball: int,
    goal_target_position: list[float],
    sensor_definitions: list[dict[str, Any]],
) -> dict[str, Any]:
    player_position = get_xyz(sim, player)
    opponent_01_position = get_xyz(sim, lawan_01)
    opponent_02_position = get_xyz(sim, lawan_02)
    ball_position = get_xyz(sim, ball)

    player_yaw = get_yaw(sim, player)
    linear_velocity, angular_velocity = get_actual_velocity(sim, player)

    linear_speed = math.hypot(linear_velocity[0], linear_velocity[1])
    angular_speed = angular_velocity[2]

    proximity = read_proximity_state(sim, sensor_definitions)

    targets = calculate_player_targets(
        player_position,
        ball_position,
        goal_target_position,
    )

    along_error, lateral_error = get_line_alignment(
        player_position,
        ball_position,
        goal_target_position,
    )

    distance_to_ball = dist2d(player_position, ball_position)
    distance_player_to_goal = dist2d(
        player_position,
        goal_target_position,
    )
    distance_ball_to_goal = dist2d(
        ball_position,
        goal_target_position,
    )

    goal_heading = math.atan2(
        goal_target_position[1] - player_position[1],
        goal_target_position[0] - player_position[0],
    )
    face_goal_error = angle_wrap(goal_heading - player_yaw)

    ball_heading = math.atan2(
        ball_position[1] - player_position[1],
        ball_position[0] - player_position[0],
    )
    face_ball_error = angle_wrap(ball_heading - player_yaw)

    player_is_on_goal_line = (
        abs(lateral_error) < ALIGN_LATERAL_TOLERANCE
    )
    player_is_behind_ball = along_error < -ALIGN_BACK_MIN
    player_not_too_far = abs(along_error) < ALIGN_BACK_MAX

    ball_in_goal = (
        abs(ball_position[0] - goal_target_position[0]) < GOAL_CHECK_X
        and abs(ball_position[1] - goal_target_position[1]) < GOAL_CHECK_Y
    )

    return {
        "robot": {
            "position": player_position,
            "yaw_rad": player_yaw,
            "linear_velocity_world": linear_velocity,
            "angular_velocity_world": angular_velocity,
            "linear_speed_mps": linear_speed,
            "angular_speed_radps": angular_speed,
        },
        "goal": {
            "position": goal_target_position.copy(),
            "distance_from_robot_m": distance_player_to_goal,
            "distance_from_ball_m": distance_ball_to_goal,
            "face_goal_error_rad": face_goal_error,
        },
        "ball": {
            "position": ball_position,
            "distance_from_robot_m": distance_to_ball,
            "face_ball_error_rad": face_ball_error,
        },
        "opponents": {
            "lawan_01_position": opponent_01_position,
            "lawan_02_position": opponent_02_position,
            "distance_to_lawan_01_m": dist2d(
                player_position,
                opponent_01_position,
            ),
            "distance_to_lawan_02_m": dist2d(
                player_position,
                opponent_02_position,
            ),
        },
        "sensor": proximity,
        "alignment": {
            "along_error_m": along_error,
            "lateral_error_m": lateral_error,
            "is_on_goal_line": player_is_on_goal_line,
            "is_behind_ball": player_is_behind_ball,
            "is_not_too_far": player_not_too_far,
        },
        "targets": targets,
        "mission": {
            "name": "dribble_red_ball_to_yellow_goal",
            "goal_reached": ball_in_goal,
        },
    }


