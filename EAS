def get_goal_center_from_children(
    sim: Any,
    goal_obj: int,
    fallback_position: list[float],
) -> list[float]:
    try:
        children = sim.getObjectsInTree(goal_obj, sim.handle_all, 1)
    except Exception:
        children = []

    points: list[list[float]] = []

    for child in children:
        try:
            point = sim.getObjectPosition(child, sim.handle_world)
            points.append(
                [float(point[0]), float(point[1]), float(point[2])]
            )
        except Exception:
            pass

    if len(points) >= 2:
        min_x = min(point[0] for point in points)
        max_x = max(point[0] for point in points)
        min_y = min(point[1] for point in points)
        max_y = max(point[1] for point in points)
        min_z = min(point[2] for point in points)

        return [
            (min_x + max_x) / 2.0,
            (min_y + max_y) / 2.0,
            min_z,
        ]

    return fallback_position.copy()


def get_adjusted_goal_target(
    goal_center_position: list[float],
) -> list[float]:
    return [
        goal_center_position[0] + GOAL_TARGET_RIGHT_SHIFT,
        goal_center_position[1],
        goal_center_position[2],
    ]


